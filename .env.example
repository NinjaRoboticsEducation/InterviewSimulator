# Copy this file to .env in EACH project copy. Shell exports override these values.
# Paths below are relative to that project's folder. Models are not bundled.
INTERVIEW_SIMULATOR_GGUF=models/primary/Qwen3.5-9B-Q4_K_M.gguf
INTERVIEW_SIMULATOR_WHISPER_MODEL=models/whisper/ggml-small.bin
INTERVIEW_SIMULATOR_TTS_BACKEND=auto
# macOS auto-detects installed Samantha, Kyoko and Meijia voices.
# Override a voice if needed (use: say -v '?').
# INTERVIEW_SIMULATOR_VOICE_EN=Samantha
# INTERVIEW_SIMULATOR_VOICE_JA=Kyoko
# INTERVIEW_SIMULATOR_VOICE_ZH_HANT=Meijia
# Optional Piper voices: configure a verified ONNX model plus its .onnx.json file.
# INTERVIEW_SIMULATOR_TTS_BACKEND=piper
# INTERVIEW_SIMULATOR_PIPER_MODEL_EN=/absolute/path/to/voice.onnx
# INTERVIEW_SIMULATOR_PIPER_MODEL_ZH_HANT=/absolute/path/to/voice.onnx
# Windows auto enumerates installed System.Speech voices; optional exact-name overrides:
# INTERVIEW_SIMULATOR_WINDOWS_VOICE_EN=Microsoft David Desktop
# INTERVIEW_SIMULATOR_WINDOWS_VOICE_JA=<exact installed Japanese voice>
# INTERVIEW_SIMULATOR_WINDOWS_VOICE_ZH_HANT=<exact installed Mandarin voice>
# Linux Japanese can use Open JTalk with its separate dictionary and HTS voice:
# INTERVIEW_SIMULATOR_TTS_BACKEND_JA=open-jtalk
# INTERVIEW_SIMULATOR_OPENJTALK_DICTIONARY=/path/to/utf8-dictionary
# INTERVIEW_SIMULATOR_OPENJTALK_VOICE=/path/to/Japanese.htsvoice
# Per-language backend overrides: ..._TTS_BACKEND_EN / JA / ZH_HANT
# Cloud API keys belong in the guided connection screen or OS vault, never this file.
