{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "opportunity", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "opportunity": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "category", "question", "fact_ids", "requirement_ids", "reference_answer"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^q-[a-z0-9][a-z0-9-]{2,79}$"},
          "category": {"enum": ["introduction", "motivation", "behavioral", "technical", "portfolio", "leadership", "role-specific", "candidate-question"]},
          "question": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^fact-"}, "uniqueItems": true},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^req-"}, "uniqueItems": true},
          "reference_answer": {"type": "string", "minLength": 1},
          "star": {
            "type": "object",
            "required": ["situation", "task", "action", "result"],
            "properties": {
              "situation": {"type": "string"},
              "task": {"type": "string"},
              "action": {"type": "string"},
              "result": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
