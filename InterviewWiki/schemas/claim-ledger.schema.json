{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "opportunity", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "opportunity": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "block_id", "artifact", "locale", "text", "fact_ids", "validation"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]{2,119}$"},
          "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,119}$"},
          "artifact": {"type": "string", "pattern": "^(Interview|Resume)/"},
          "locale": {"enum": ["en", "ja", "bilingual"]},
          "text": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^fact-"}, "uniqueItems": true},
          "validation": {"enum": ["supported", "partially-supported", "candidate-confirmation-required", "unsupported"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
