{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "opportunity", "workflow_version", "task_kind", "execution_id", "created_at", "tool", "model", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 2},
    "opportunity": {"type": "string"},
    "workflow_version": {"type": "string"},
    "task_kind": {"type": "string"},
    "execution_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string"},
    "tool": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "candidate_migration_id": {"type": ["string", "null"]},
    "completed_at": {"type": "string"},
    "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
